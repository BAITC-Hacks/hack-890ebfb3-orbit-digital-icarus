# Optional backend configuration. Do not put secrets in this file.
# Load a copied .env file with: python -m uvicorn backend.app.main:app --env-file .env
# Relative DATA_PATH values are resolved from the repository root.
DATA_PATH=data/contractors.csv
# The API gets its algorithm version from backend.app.matching.algorithm_version().
# Comma-separated browser origins allowed to call the local development API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional account/listing/event state; this file and sessions never enter the source CSV.
COMMUNITY_DB_PATH=.orbit/community.sqlite3
# Optional offline proposal tool only. The web app and CI do not need this key.
# Prefer --key-file pointing outside this repository. Never fill in this example.
NVIDIA_API_KEY=
OPENAI_API_KEY=
